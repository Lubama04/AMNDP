# Clé API Resend (https://resend.com) — nécessaire pour l'envoi d'emails
# depuis /api/contact.js et /api/donate.js. Ne jamais commiter la vraie valeur.
RESEND_API_KEY=

# Adresse d'expédition vérifiée dans Resend (domaine vérifié, ou
# onboarding@resend.dev en attendant de vérifier le nom de domaine de l'AMNDP)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Adresse qui reçoit les messages du formulaire de contact
CONTACT_TO_EMAIL=associationmndptchad@gmail.com

# Adresse qui reçoit les demandes de don (peut être la même que ci-dessus)
DONATION_TO_EMAIL=associationmndptchad@gmail.com

# TODO-CLIENT : limitation de débit (rate limiting) des API /api/contact et
# /api/donate. Aucun stockage persistant (KV/Redis) n'est configuré sur ce
# projet, donc un compteur en mémoire dans la fonction serverless ne serait
# pas fiable (chaque appel peut atterrir sur une instance différente).
# Deux options, à décider par le client :
#   1. Activer le "Rate Limiting" du Vercel Firewall dans le tableau de
#      bord du projet (aucune variable d'environnement nécessaire) ;
#   2. Provisionner une base Upstash Redis (ou Vercel KV) et ajouter ici
#      UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN pour un futur
#      compteur partagé par IP dans le code des API.
