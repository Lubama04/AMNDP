# Clé API Resend (https://resend.com) — nécessaire pour l'envoi d'emails
# depuis /api/contact.js et /api/donate.js. Ne jamais commiter la vraie valeur.
RESEND_API_KEY=

# Adresse d'expédition vérifiée dans Resend (domaine vérifié, ou
# onboarding@resend.dev en attendant de vérifier le nom de domaine de l'AMNDP)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Adresse qui reçoit les messages du formulaire de contact
CONTACT_TO_EMAIL=associationmndptchad@gmail.com

# Adresse qui reçoit les demandes de don (peut être la même que ci-dessus)
DONATION_TO_EMAIL=associationmndptchad@gmail.com

# TODO-CLIENT : limitation de débit (rate limiting) des API /api/contact et
# /api/donate. Procédure pas à pas dans README.md, section Sécurité.
# Si l'option Upstash Redis / Vercel KV est retenue à la place du Vercel
# Firewall, ajouter ici UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
